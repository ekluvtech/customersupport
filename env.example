# Docker Environment Variables
# Copy this file to .env and fill in your values

# Zendesk Configuration
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=your-email@example.com
ZENDESK_API_KEY=your-api-key

# Slack Configuration
SLACK_TOKEN=xoxb-your-slack-token

# Database Configuration
# If using external database, provide full connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname
# If using Docker database (uncomment db service in docker-compose.yml)
# POSTGRES_USER=customersupport
# POSTGRES_PASSWORD=password
# POSTGRES_DB=customersupport

# LLM Configuration
LLM_PROVIDER=vertexai
# For OpenAI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key

# Google Cloud / Vertex AI Configuration
GOOGLE_APPLICATION_CREDENTIALS=/app/.google-credentials
GOOGLE_CLOUD_PROJECT=your-project-id

# Memory Backend
MEMORY_BACKEND=memory
# For ChromaDB:
# MEMORY_BACKEND=chromadb
# CHROMADB_PATH=/app/data/chroma

# Frontend API URL (for build-time)
VITE_API_URL=http://localhost:8100

# MCP Server URL (for agent API to connect)
MCP_SERVER_URL=http://mcp-server:8000

